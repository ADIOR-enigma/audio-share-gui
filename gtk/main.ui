<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk+" version="3.20"/>

  <object class="GtkWindow" id="main_window">
    <property name="decorated">false</property>
    <property name="resizable">true</property>
    <property name="default-width">360</property>

    <child>
      <object class="GtkBox" id="root_box">
        <property name="orientation">vertical</property>
        <property name="spacing">12</property>
        <property name="margin">12</property>

        <!-- HEADER -->
        <child>
          <object class="GtkBox">
            <property name="orientation">horizontal</property>
            <property name="spacing">8</property>
            <property name="height-request">28</property>

            <child>
              <object class="GtkImage" id="app_logo">
              </object>
            </child>

            <child>
              <object class="GtkLabel" id="title_label">
                <property name="label">Audio Share Server</property>
                <property name="hexpand">true</property>
                <property name="xalign">0</property>
              </object>
            </child>

            <child>
              <object class="GtkButton" id="close_button">
                <property name="label">✕</property>
              </object>
            </child>
          </object>
        </child>

        <!-- CONTROLS -->
        <child>
          <object class="GtkGrid">
            <property name="column-spacing">8</property>
            <property name="row-spacing">8</property>

            <!-- Endpoint -->
            <child>
              <object class="GtkLabel">
                <property name="label">Endpoint:</property>
              </object>
              <packing>
                <property name="left-attach">0</property>
                <property name="top-attach">0</property>
              </packing>
            </child>

            <child>
              <object class="GtkComboBoxText" id="endpoint_combo"/>
              <packing>
                <property name="left-attach">1</property>
                <property name="top-attach">0</property>
              </packing>
            </child>

            <!-- Host -->
            <child>
              <object class="GtkLabel">
                <property name="label">Host:</property>
              </object>
              <packing>
                <property name="left-attach">0</property>
                <property name="top-attach">1</property>
              </packing>
            </child>

            <child>
              <object class="GtkComboBoxText" id="host_dropdown"/>
              <packing>
                <property name="left-attach">1</property>
                <property name="top-attach">1</property>
              </packing>
            </child>

            <!-- Port -->
            <child>
              <object class="GtkLabel">
                <property name="label">Port:</property>
              </object>
              <packing>
                <property name="left-attach">0</property>
                <property name="top-attach">2</property>
              </packing>
            </child>

            <child>
              <object class="GtkEntry" id="port_entry">
                <property name="text">65530</property>
              </object>
              <packing>
                <property name="left-attach">1</property>
                <property name="top-attach">2</property>
              </packing>
            </child>

            <!-- Encoding -->
            <child>
              <object class="GtkLabel">
                <property name="label">Encoding:</property>
              </object>
              <packing>
                <property name="left-attach">0</property>
                <property name="top-attach">3</property>
              </packing>
            </child>

            <child>
              <object class="GtkComboBoxText" id="encoding_combo"/>
              <packing>
                <property name="left-attach">1</property>
                <property name="top-attach">3</property>
              </packing>
            </child>

            <!-- Verbose -->
            <child>
              <object class="GtkCheckButton" id="verbose_check">
                <property name="label">Verbose logging</property>
              </object>
              <packing>
                <property name="left-attach">1</property>
                <property name="top-attach">6</property>
              </packing>
            </child>

          </object>
        </child>

        <!-- START -->
        <child>
          <object class="GtkButton" id="start_button">
            <property name="label">Start Server</property>
          </object>
        </child>

        <!-- LOGS -->
        <child>
          <object class="GtkExpander">
            <property name="label">Details</property>
            <property name="expanded">true</property>

            <child>
              <object class="GtkFrame">
                <property name="shadow-type">in</property>

                <child>
                  <object class="GtkScrolledWindow">
                    <property name="min-content-height">120</property>

                    <child>
                      <object class="GtkTextView" id="log_view">
                        <property name="editable">false</property>
                        <property name="cursor-visible">false</property>
                        <property name="monospace">true</property>
                        <property name="wrap-mode">word-char</property>
                        <property name="margin">6</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>

      </object>
    </child>
  </object>
</interface>
